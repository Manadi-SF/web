---
/**
 * Grilla de productos de una rama del catalogo.
 *
 * Las tres ramas se ven igual, asi que la pagina de cada una es un archivo de
 * dos lineas que le pasa cual es y este componente arma el resto.
 */
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { RAMAS, type Rama } from '../lib/sitio';
import TarjetaProducto from './TarjetaProducto.astro';

interface Props {
  rama: Rama;
}

const { rama } = Astro.props;
const { titulo, meta, intro } = RAMAS[rama];

const productos = (
  await getCollection('productos', ({ data }) => data.categoria === rama)
).sort((a, b) => a.data.orden - b.data.orden);
---

<Base titulo={titulo} descripcion={meta}>
  <div class="mx-auto max-w-6xl px-5 py-16 sm:px-8 sm:py-24">
    <header class="max-w-2xl">
      <p class="text-sm tracking-widest text-marron/50 uppercase">
        Nuestros productos
      </p>
      <h1 class="mt-3 text-5xl sm:text-6xl">{titulo}</h1>
      <p class="mt-6 text-lg/relaxed text-marron/70">{intro}</p>
    </header>

    <div class="mt-16 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        productos.map((producto, i) => (
          <TarjetaProducto producto={producto} prioridad={i < 3} />
        ))
      }
    </div>
  </div>
</Base>
