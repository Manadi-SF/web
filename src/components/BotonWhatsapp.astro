---
/**
 * Boton flotante de WhatsApp.
 *
 * Se queda fijo abajo a la derecha porque la venta cierra siempre por ahi: no
 * hay carrito ni checkout, asi que conviene que el acceso este a mano en
 * cualquier punto de la pagina.
 */
import { enlaceWhatsapp } from '../lib/sitio';

interface Props {
  /** Nombre del producto, para que el mensaje llegue con contexto. */
  producto?: string;
}

const { producto } = Astro.props;
---

<a
  href={enlaceWhatsapp(producto)}
  target="_blank"
  rel="noopener"
  class="fixed right-5 bottom-5 z-50 flex items-center gap-2.5 rounded-full bg-marron py-3.5 pr-5 pl-4 text-beige shadow-lg shadow-marron/25 transition-transform hover:scale-105 focus-visible:scale-105 sm:right-8 sm:bottom-8"
>
  <svg class="size-6 shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
    <path
      d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.46 1.32 4.96L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2Zm0 1.67c2.2 0 4.27.86 5.82 2.42a8.18 8.18 0 0 1 2.42 5.82c0 4.54-3.7 8.24-8.25 8.24a8.24 8.24 0 0 1-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.19 8.19 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.26-8.24Zm-3.6 4.03c-.17 0-.45.06-.68.31-.24.25-.9.88-.9 2.14 0 1.26.92 2.48 1.05 2.65.13.17 1.78 2.84 4.4 3.87 2.18.86 2.62.69 3.1.64.48-.04 1.54-.63 1.76-1.24.22-.61.22-1.14.15-1.25-.06-.11-.24-.17-.5-.3-.26-.13-1.54-.76-1.78-.85-.24-.09-.41-.13-.59.13-.17.26-.68.85-.83 1.03-.15.17-.3.19-.55.06-.26-.13-1.1-.4-2.09-1.29-.77-.68-1.29-1.53-1.44-1.79-.15-.26-.02-.4.11-.53.12-.12.26-.3.39-.46.13-.15.17-.26.26-.44.09-.17.04-.33-.02-.46-.06-.13-.55-1.4-.76-1.91-.2-.5-.4-.44-.55-.45h-.53Z"
    />
  </svg>
  <span class="text-sm font-medium">Consultar</span>
</a>
