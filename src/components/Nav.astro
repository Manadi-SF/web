---
import Logo from './Logo.astro';
import { NAVEGACION, SITIO, enlaceWhatsapp } from '../lib/sitio';

const actual = Astro.url.pathname;
const esActual = (href: string) =>
  actual === href || (href !== '/' && actual.startsWith(href));
---

<header
  class="sticky top-0 z-40 border-b border-marron/10 bg-hueso/85 backdrop-blur-md"
>
  <nav
    class="mx-auto flex max-w-6xl items-center gap-4 px-5 py-4 sm:gap-6 sm:px-8"
    aria-label="Principal"
  >
    <a
      href="/"
      class="group flex shrink-0 items-center gap-3 text-marron"
      aria-label={`${SITIO.nombre}, inicio`}
    >
      <Logo
        variante="isotipo"
        class="h-7 w-auto transition-opacity group-hover:opacity-70"
      />
      {/*
        uppercase: Engravers Gothic convierte las minusculas en versalitas, asi
        que "Manadi" sale con la M grande y el resto chico. La marca va toda del
        mismo tamano.

        Debajo de 390px no entra junto al menu, asi que ahi queda solo el
        isotipo. El nombre igual lo anuncia el aria-label del enlace.
      */}
      <span
        class="hidden font-titulo text-lg leading-none tracking-[0.1em] uppercase transition-opacity group-hover:opacity-70 min-[390px]:inline sm:text-2xl sm:tracking-[0.12em]"
      >
        {SITIO.nombre}
      </span>
    </a>

    <ul
      class="ml-auto flex items-center gap-4 text-sm tracking-wide whitespace-nowrap sm:gap-6"
    >
      {
        NAVEGACION.map(({ texto, href }) => (
          <li>
            <a
              href={href}
              aria-current={esActual(href) ? 'page' : undefined}
              class="relative py-2 transition-colors hover:text-cacao aria-[current=page]:font-semibold"
            >
              {texto}
              {esActual(href) && (
                <span
                  class="absolute -bottom-0.5 left-0 h-px w-full bg-marron"
                  aria-hidden="true"
                />
              )}
            </a>
          </li>
        ))
      }
      <li>
        <a
          href={enlaceWhatsapp()}
          target="_blank"
          rel="noopener"
          class="hidden rounded-full bg-marron px-5 py-2.5 font-medium text-beige transition-colors hover:bg-cacao sm:inline-block"
        >
          Cotizar
        </a>
      </li>
    </ul>
  </nav>
</header>
