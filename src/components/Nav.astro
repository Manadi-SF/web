---
/**
 * Encabezado del sitio.
 *
 * El catalogo tiene varias ramas, asi que van agrupadas bajo "Nuestros
 * productos" como estaba pensado en la nota original. Solo se listan las ramas
 * que tienen productos cargados: personalizados aparece solo el dia que se
 * cargue el primero.
 *
 * Los dos desplegables son <details>, no divs con JavaScript: asi abren y
 * cierran aunque el script no llegue a cargar. El script solo agrega lo que el
 * navegador no da gratis, que es cerrarlos al tocar afuera, con Escape o al
 * cambiar de pagina.
 */
import { getCollection } from 'astro:content';
import { NAVEGACION, RAMAS, SITIO, enlaceWhatsapp, type Rama } from '../lib/sitio';
import Logo from './Logo.astro';

const productos = await getCollection('productos');
const ramas = (Object.keys(RAMAS) as Rama[])
  .filter((rama) => productos.some(({ data }) => data.categoria === rama))
  .map((rama) => RAMAS[rama]);

const actual = Astro.url.pathname;
const esActual = (href: string) =>
  actual === href || (href !== '/' && actual.startsWith(href));
const enProductos = ramas.some(({ ruta }) => esActual(ruta));

const claseEnlace =
  'relative block py-2 transition-colors hover:text-cacao aria-[current=page]:font-semibold';
---

<header
  class="sticky top-0 z-40 border-b border-marron/10 bg-hueso/85 backdrop-blur-md"
>
  <nav
    class="mx-auto flex max-w-6xl items-center gap-4 px-5 py-4 sm:gap-6 sm:px-8"
    aria-label="Principal"
  >
    <a
      href="/"
      class="group flex shrink-0 items-center gap-3 text-marron"
      aria-label={`${SITIO.nombre}, inicio`}
    >
      <Logo
        variante="isotipo"
        class="h-7 w-auto transition-opacity group-hover:opacity-70"
      />
      {/*
        uppercase: Engravers Gothic convierte las minusculas en versalitas, asi
        que "Manadi" sale con la M grande y el resto chico. La marca va toda del
        mismo tamano.
      */}
      <span
        class="font-titulo text-lg leading-none tracking-[0.08em] uppercase transition-opacity group-hover:opacity-70 sm:text-2xl sm:tracking-[0.12em]"
      >
        {SITIO.nombre}
      </span>
    </a>

    {/* Menu de escritorio. En el celular no entra y lo reemplaza el de abajo. */}
    <ul
      class="ml-auto hidden items-center gap-6 text-sm tracking-wide whitespace-nowrap sm:flex"
    >
      <li class="relative">
        <details class="group" data-desplegable>
          <summary
            class={`flex cursor-pointer list-none items-center gap-1.5 py-2 transition-colors hover:text-cacao [&::-webkit-details-marker]:hidden ${
              enProductos ? 'font-semibold' : ''
            }`}
          >
            Nuestros productos
            <svg
              viewBox="0 0 24 24"
              fill="none"
              class="size-3.5 transition-transform duration-300 group-open:rotate-180"
              aria-hidden="true"
            >
              <path
                d="m6 9 6 6 6-6"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </summary>

          <ul
            class="absolute left-0 z-50 mt-1 min-w-60 rounded-2xl border border-marron/10 bg-hueso p-2 shadow-xl shadow-marron/10"
          >
            {
              ramas.map(({ ruta, titulo }) => (
                <li>
                  <a
                    href={ruta}
                    aria-current={esActual(ruta) ? 'page' : undefined}
                    class="block rounded-xl px-3 py-2.5 transition-colors hover:bg-crema aria-[current=page]:font-semibold"
                  >
                    {titulo}
                  </a>
                </li>
              ))
            }
          </ul>
        </details>
      </li>

      {
        NAVEGACION.map(({ texto, href }) => (
          <li>
            <a
              href={href}
              aria-current={esActual(href) ? 'page' : undefined}
              class={claseEnlace}
            >
              {texto}
              {esActual(href) && (
                <span
                  class="absolute -bottom-0.5 left-0 h-px w-full bg-marron"
                  aria-hidden="true"
                />
              )}
            </a>
          </li>
        ))
      }

      <li>
        <a
          href={enlaceWhatsapp()}
          target="_blank"
          rel="noopener"
          class="rounded-full bg-marron px-5 py-2.5 font-medium text-beige transition-colors hover:bg-cacao"
        >
          Cotizar
        </a>
      </li>
    </ul>

    {/* Menu de celular. */}
    <details class="ml-auto sm:hidden" data-desplegable data-menu-celular>
      <summary
        class="flex size-10 cursor-pointer list-none items-center justify-center rounded-full transition-colors hover:bg-crema [&::-webkit-details-marker]:hidden"
        aria-label="Abrir el menú"
      >
        <svg viewBox="0 0 24 24" fill="none" class="size-6" aria-hidden="true">
          <path
            d="M4 7h16M4 12h16M4 17h16"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
          />
        </svg>
      </summary>

      <div
        class="absolute inset-x-0 top-full border-b border-marron/10 bg-hueso p-5 shadow-xl shadow-marron/10"
      >
        <p class="text-xs tracking-widest text-marron/50 uppercase">
          Nuestros productos
        </p>
        <ul class="mt-2 space-y-1">
          {
            ramas.map(({ ruta, titulo }) => (
              <li>
                <a
                  href={ruta}
                  aria-current={esActual(ruta) ? 'page' : undefined}
                  class="block rounded-xl py-2.5 transition-colors aria-[current=page]:font-semibold"
                >
                  {titulo}
                </a>
              </li>
            ))
          }
        </ul>

        <ul class="mt-4 space-y-1 border-t border-marron/10 pt-4">
          {
            NAVEGACION.map(({ texto, href }) => (
              <li>
                <a
                  href={href}
                  aria-current={esActual(href) ? 'page' : undefined}
                  class="block rounded-xl py-2.5 transition-colors aria-[current=page]:font-semibold"
                >
                  {texto}
                </a>
              </li>
            ))
          }
        </ul>

        <a
          href={enlaceWhatsapp()}
          target="_blank"
          rel="noopener"
          class="mt-4 block rounded-full bg-marron px-5 py-3 text-center font-medium text-beige transition-colors hover:bg-cacao"
        >
          Cotizar
        </a>
      </div>
    </details>
  </nav>
</header>

<script>
  function activarMenus() {
    const desplegables =
      document.querySelectorAll<HTMLDetailsElement>('[data-desplegable]');
    if (desplegables.length === 0) return;

    const cerrarTodos = (salvo?: Element | null) => {
      desplegables.forEach((d) => {
        if (d !== salvo) d.open = false;
      });
    };

    desplegables.forEach((desplegable) => {
      // Abrir uno cierra el otro: si no, en las pantallas donde conviven
      // quedarian los dos paneles superpuestos.
      desplegable.addEventListener('toggle', () => {
        if (desplegable.open) cerrarTodos(desplegable);
      });
    });

    document.addEventListener('click', (evento) => {
      const destino = evento.target as Element | null;
      cerrarTodos(destino?.closest('[data-desplegable]'));
    });

    document.addEventListener('keydown', (evento) => {
      if (evento.key === 'Escape') cerrarTodos();
    });
  }

  activarMenus();
  // Las transiciones de Astro no recargan la pagina: hay que reenganchar los
  // listeners y, de paso, cerrar lo que quedo abierto al navegar.
  document.addEventListener('astro:page-load', activarMenus);
</script>
