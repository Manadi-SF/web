---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import hero from '../assets/productos/mesa-matera-tapir-1.jpg';
import Logo from '../components/Logo.astro';
import TarjetaProducto from '../components/TarjetaProducto.astro';
import Base from '../layouts/Base.astro';
import { CONTACTO, SITIO, enlaceWhatsapp } from '../lib/sitio';

const coleccion = (await getCollection('productos', ({ data }) => data.categoria === 'coleccion')).sort(
  (a, b) => a.data.orden - b.data.orden,
);
const destacados = coleccion.filter(({ data }) => data.destacado);
---

<Base titulo={SITIO.nombre}>
  <section class="relative isolate overflow-hidden bg-marron text-beige">
    <Image
      src={hero}
      alt="Mesa matera de Manadi en el pasto, con mate y termo"
      widths={[640, 1024, 1600, 2000]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      class="absolute inset-0 -z-10 size-full object-cover object-center opacity-45"
    />

    <div class="mx-auto max-w-6xl px-5 py-28 sm:px-8 sm:py-40">
      <Logo class="h-24 w-auto text-beige sm:h-32" titulo={SITIO.nombre} />

      <p class="mt-10 max-w-xl text-lg/relaxed text-beige/90 sm:text-xl/relaxed">
        Diseñamos, cortamos y grabamos con láser en Santa Fe. Cada pieza sale
        pensada, probada y ajustada hasta que queda como la imaginamos.
      </p>

      <div class="mt-10 flex flex-wrap gap-4">
        <a
          href="/coleccion"
          class="rounded-full bg-beige px-7 py-3.5 font-medium text-marron transition-colors hover:bg-hueso"
        >
          Ver la colección
        </a>
        <a
          href={enlaceWhatsapp()}
          target="_blank"
          rel="noopener"
          class="rounded-full border border-beige/40 px-7 py-3.5 font-medium transition-colors hover:border-beige hover:bg-beige/10"
        >
          Pedir una cotización
        </a>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 py-24 sm:px-8">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="text-sm tracking-widest text-marron/50 uppercase">Nuestros productos</p>
        <h2 class="mt-2 text-4xl sm:text-5xl">Colección Manadi</h2>
      </div>
      <a
        href="/coleccion"
        class="text-sm underline decoration-marron/30 underline-offset-4 transition-colors hover:decoration-marron"
      >
        Ver los {coleccion.length} productos
      </a>
    </div>

    <p class="mt-6 max-w-2xl text-marron/70">
      Piezas que diseñamos nosotros y hacemos a pedido. Muchas se personalizan:
      elegís colores, grabado o le ponemos el nombre que quieras.
    </p>

    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        destacados.map((producto, i) => (
          <TarjetaProducto producto={producto} prioridad={i === 0} />
        ))
      }
    </div>
  </section>

  <section class="border-y border-marron/10 bg-crema">
    <div class="mx-auto grid max-w-6xl gap-10 px-5 py-20 sm:px-8 md:grid-cols-3">
      <div class="aparece">
        <h3 class="text-2xl">Materiales</h3>
        <p class="mt-3 text-sm/relaxed text-marron/70">
          Trabajamos MDF, acrílico y ecocuero. Etiquetas, llaveros, souvenirs,
          centros de mesa y material educativo.
        </p>
      </div>
      <div class="aparece">
        <h3 class="text-2xl">Personalizados</h3>
        <p class="mt-3 text-sm/relaxed text-marron/70">
          Juegos, cartelería, organizadores y cuadernos. Si tenés una idea, la
          diseñamos y la cortamos.
        </p>
      </div>
      <div class="aparece">
        <h3 class="text-2xl">A pedido</h3>
        <p class="mt-3 text-sm/relaxed text-marron/70">
          Contanos qué necesitás por WhatsApp y te pasamos una cotización sin
          compromiso.
        </p>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-5 py-24 text-center sm:px-8">
    <h2 class="text-4xl sm:text-5xl">¿Tenés una idea?</h2>
    <p class="mx-auto mt-5 max-w-xl text-marron/70">
      Escribinos por WhatsApp y la charlamos. Hacemos envíos a todo el país.
    </p>
    <div class="mt-10 flex flex-wrap justify-center gap-4">
      <a
        href={enlaceWhatsapp()}
        target="_blank"
        rel="noopener"
        class="rounded-full bg-marron px-7 py-3.5 font-medium text-beige transition-colors hover:bg-cacao"
      >
        Escribinos al {CONTACTO.whatsappVisible}
      </a>
      <a
        href={`https://www.instagram.com/${CONTACTO.instagram}/`}
        target="_blank"
        rel="noopener"
        class="rounded-full border border-marron/25 px-7 py-3.5 font-medium transition-colors hover:border-marron hover:bg-crema"
      >
        Seguinos en Instagram
      </a>
    </div>
  </section>
</Base>
