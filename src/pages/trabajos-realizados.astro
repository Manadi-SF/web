---
import { Image, type ImageMetadata } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { TRABAJOS, enlaceWhatsapp } from '../lib/sitio';
import { TRABAJOS_ITEMS } from '../lib/trabajos';

const archivos = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/trabajos/*.jpg',
  { eager: true },
);

const fotos = TRABAJOS_ITEMS.map((item) => {
  const modulo = archivos[`../assets/trabajos/${item.id}.jpg`];
  if (!modulo) throw new Error(`Falta la foto de trabajos/${item.id}.jpg`);
  return { ...item, src: modulo.default };
});
---

<Base titulo={TRABAJOS.titulo} descripcion={TRABAJOS.meta}>
  <div class="mx-auto max-w-6xl px-5 py-16 sm:px-8 sm:py-24">
    <header class="max-w-2xl">
      <p class="text-sm tracking-widest text-marron/50 uppercase">
        Nuestros productos
      </p>
      <h1 class="mt-3 text-4xl sm:text-5xl lg:text-6xl">{TRABAJOS.titulo}</h1>
      <p class="mt-6 text-lg/relaxed text-marron/70">{TRABAJOS.intro}</p>
    </header>

    {/*
      Columnas CSS: las fotos son casi todas verticales y de distinta altura,
      y una grilla uniforme las recortaba. Asi se ven enteras. En el celular
      van de a dos: una sola columna, con 31 fotos, pedia un scroll enorme.
      break-inside evita que una figura se parta entre dos columnas.
    */}
    <div class="mt-12 columns-2 gap-3 sm:mt-16 sm:columns-3 sm:gap-5 lg:columns-4">
      {
        fotos.map((foto, i) => (
          <figure class="mb-3 break-inside-avoid sm:mb-5">
            <Image
              src={foto.src}
              alt={foto.alt}
              widths={[240, 400, 640]}
              sizes="(min-width: 1024px) 22vw, (min-width: 640px) 30vw, 45vw"
              loading={i < 4 ? 'eager' : 'lazy'}
              class="h-auto w-full max-w-full rounded-2xl bg-crema"
            />
            <figcaption class="mt-1.5 px-0.5 text-xs text-marron/60 sm:mt-2.5 sm:text-sm">
              {foto.titulo}
            </figcaption>
          </figure>
        ))
      }
    </div>

    <div class="mt-20 text-center">
      <h2 class="text-4xl sm:text-5xl">¿Tenés una idea así?</h2>
      <p class="mx-auto mt-5 max-w-xl text-marron/70">
        Escribinos por WhatsApp y la charlamos. Lo diseñamos con vos.
      </p>
      <a
        href={enlaceWhatsapp()}
        target="_blank"
        rel="noopener"
        class="mt-10 inline-block rounded-full bg-marron px-7 py-3.5 font-medium text-beige transition-colors hover:bg-cacao"
      >
        Pedir una cotización
      </a>
    </div>
  </div>
</Base>
