---
import { getCollection } from 'astro:content';
import TarjetaProducto from '../../components/TarjetaProducto.astro';
import Base from '../../layouts/Base.astro';

const productos = (
  await getCollection('productos', ({ data }) => data.categoria === 'coleccion')
).sort((a, b) => a.data.orden - b.data.orden);
---

<Base
  titulo="Colección Manadi"
  descripcion="Mesas materas, decoración para la pared, organizadores y más. Piezas diseñadas y cortadas con láser en Santa Fe."
>
  <div class="mx-auto max-w-6xl px-5 py-16 sm:px-8 sm:py-24">
    <header class="max-w-2xl">
      <p class="text-sm tracking-widest text-marron/50 uppercase">Nuestros productos</p>
      <h1 class="mt-3 text-5xl sm:text-6xl">Colección Manadi</h1>
      <p class="mt-6 text-lg/relaxed text-marron/70">
        Estos son los productos que diseñamos nosotros. Los hacemos a pedido y
        varios se personalizan: elegís el color, el grabado o le sumamos el
        nombre que quieras.
      </p>
    </header>

    <div class="mt-16 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        productos.map((producto, i) => (
          <TarjetaProducto producto={producto} prioridad={i < 3} />
        ))
      }
    </div>
  </div>
</Base>
